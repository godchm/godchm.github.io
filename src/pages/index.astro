---
import { projects } from '../data/projects';

const profile = {
  name: '최형민',
  role: '백엔드 개발자 | PM 인턴 경험',
  location: 'Seoul, Korea',
  email: 'stc05051@naver.com',
  github: 'https://github.com/godchm',
  headline: '개발과 제품 관점을 함께 이해하는 백엔드 개발자',
  summary:
    'KDT 백엔드 개발 과정에서 Java/Spring 기반 프로젝트를 통해 서비스 설계부터 개발까지 경험했으며, 수료 후 SQLD 자격을 취득했습니다. 현재 SaaS 기업 벳플럭스에서 PM 인턴으로 근무하며 제품 개발 과정에 참여하고 있습니다.',
};

const highlights = [
  { label: 'Current', value: 'Vetflux PM Intern' },
  { label: 'Core', value: 'Java / Spring' },
  { label: 'Certification', value: 'SQLD' },
];

const experience = {
  company: '벳플럭스 (Vetflux)',
  role: 'PM',
  period: '2026.08.10 - 현재',
  description: 'SaaS 기업에서 PM 인턴으로 근무하며 QA, 서비스 기획, 명세서 작성, 컨퍼런스 참여를 경험했습니다.',
};

const certification = {
  name: 'SQLD (SQL 개발자)',
  date: '2026.09 합격',
};

const skillGroups = [
  {
    title: 'Backend',
    items: ['Java', 'Spring Boot', 'Spring Security', 'Spring Data JPA', 'QueryDSL', 'JWT'],
  },
  {
    title: 'Data / Infra',
    items: ['MySQL', 'PostgreSQL', 'Redis', 'Kafka', 'Docker', 'AWS', 'GitHub Actions'],
  },
  {
    title: 'Ops / AI',
    items: ['Prometheus', 'Grafana', 'Loki', 'n8n', 'Spring AI', 'OpenAI API', 'RAG'],
  },
  {
    title: 'Frontend',
    items: ['React', 'JavaScript', 'Vite'],
  },
];

const education = {
  school: '팀 스파르타',
  course: 'KDT 실시간 커머스 플랫폼 개발자 양성과정 수료',
  period: '2025.12 - 2026.06',
};

const getProjectStart = (period: string) => {
  const [start] = period.split(' - ');
  return Number(start.replaceAll('.', ''));
};

const sortedProjects = [...projects].sort((a, b) => getProjectStart(b.period) - getProjectStart(a.period));

const introduction = [
  {
    title: '팀이 같은 방향으로 가도록 조율하는 개발자',
    body:
      '백엔드 개발자를 목표로 하며 여러 팀 프로젝트에서 팀장 역할을 맡았습니다. 프로젝트 초반에는 목표와 진행 방식을 정리하고, 회의에서는 팀원들의 의견을 조율하며 각자의 역할이 서비스 방향과 맞물리도록 돕는 데 집중했습니다.',
  },
  {
    title: '비전공에서 출발해 문제 해결의 기초를 다졌습니다',
    body:
      '행정학을 전공했지만 재학 중 C언어 과목에서 A+를 받으며 프로그래밍의 기초와 문제 해결 과정에 흥미를 느꼈습니다. 이후 백엔드 개발자를 목표로 하면서도 서비스 전체 흐름을 이해하기 위해 프론트엔드 인터넷 강의도 수강했습니다. 또한 AI를 활용해 졸업논문을 작성하고 프로젝트에서 AI 기능을 개발하며, 새로운 기술을 실제 문제에 적용하는 경험을 쌓았습니다.',
  },
  {
    title: '데이터베이스를 더 깊이 이해하기 위해 SQLD를 취득했습니다',
    body:
      'Java와 Spring Boot로 백엔드 프로젝트를 진행하며 데이터가 저장되는 구조와 테이블 간 관계를 제대로 이해하고 싶었습니다. PM 인턴 업무에서도 데이터를 확인하거나 개발자와 소통할 때 도움이 될 기본기를 체계적으로 다지기 위해 SQLD를 준비했고, 2026년 9월 합격했습니다.',
  },
  {
    title: 'PM 인턴으로 서비스가 만들어지는 과정에 참여하고 있습니다',
    body:
      '벳플럭스에서 QA, 서비스 기획, 명세서 작성, 컨퍼런스 참여를 경험했습니다. 백엔드 개발 경험을 바탕으로 기능의 동작을 확인하고 서비스 요구사항을 정리하며, 제품을 사용자와 기획의 관점에서도 살펴보고 있습니다.',
  },
  {
    title: '운영과 사용자 흐름까지 함께 보는 백엔드 개발자',
    body:
      '기능이 정상적으로 동작하는 것에서 그치지 않고, 실제 운영 환경에서 안정적으로 유지될 수 있는 구조를 중요하게 생각합니다. 프로젝트에서는 모니터링 환경을 구성하고 지표를 확인하며, 장애 징후를 빠르게 파악하고 안정적인 서비스를 유지하는 중요성을 배웠습니다.',
  },
];
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} 백엔드 개발자 이력서`} />
    <title>{profile.name} | Backend Resume</title>
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="페이지 내 이동">
        <div>
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#projects">Projects</a>
          <a href="#education">Education</a>
          <a href="#certifications">Certifications</a>
        </div>
      </nav>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Backend Developer Resume</p>
          <h1 id="hero-title">{profile.name}</h1>
          <p class="role">{profile.role}</p>
          <p class="headline">{profile.headline}</p>
          <p class="summary">{profile.summary}</p>

          <div class="actions" aria-label="연락 링크">
            <a class="primary" href="#projects">프로젝트 보기</a>
            <a href={`mailto:${profile.email}`}>Email</a>
            <a href={profile.github}>GitHub</a>
          </div>
        </div>

        <aside class="profile-panel" aria-label="프로필 요약">
          <div class="panel-heading">
            <p class="eyebrow">Contact</p>
            <h2>Profile</h2>
          </div>
          <dl>
            <div>
              <dt>Location</dt>
              <dd>{profile.location}</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>{profile.email}</dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd>{profile.github.replace('https://', '')}</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="metrics" aria-label="핵심 정보">
        {
          highlights.map((item) => (
            <div class="metric">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </div>
        ))
      }
      </section>

      <section class="section" id="about" aria-labelledby="about-title">
        <div class="section-title">
          <p class="eyebrow">About Me</p>
          <h2 id="about-title">Introduction</h2>
          <p>비전공자로 시작해 백엔드를 공부하고, SQLD 취득과 PM 인턴 경험으로 데이터와 서비스 기획까지 시야를 넓히고 있습니다.</p>
        </div>
        <div class="intro-list">
          {
            introduction.map((item) => (
              <article class="intro-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-title">
        <div class="section-title">
          <p class="eyebrow">Career</p>
          <h2 id="experience-title">Experience</h2>
        </div>
        <article class="record-card">
          <span>{experience.period}</span>
          <h3>{experience.company}</h3>
          <p class="record-role">{experience.role}</p>
          <p>{experience.description}</p>
        </article>
      </section>

      <section class="section" id="skills" aria-labelledby="skills-title">
        <div class="section-title">
          <p class="eyebrow">Capabilities</p>
          <h2 id="skills-title">Skills</h2>
        </div>
        <div class="skill-grid">
          {
            skillGroups.map((group) => (
              <article class="skill-card">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((skill) => <li>{skill}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="projects" aria-labelledby="projects-title">
        <div class="section-title">
          <p class="eyebrow">Selected Work</p>
          <h2 id="projects-title">Projects</h2>
          <p>카드를 누르면 프로젝트별 구현 내용과 기술적 의사결정을 자세히 볼 수 있습니다.</p>
        </div>
        <div class="project-grid">
          {
            sortedProjects.map((project) => (
              <article class="project-card">
                <div class="project-top">
                  <span>{project.period}</span>
                  <strong>{project.team}</strong>
                </div>
                <h3>{project.title}</h3>
                <p class="subtitle">{project.subtitle}</p>
                <p>{project.summary}</p>
                <ul class="tags featured-tags" aria-label={`${project.title} 핵심 구현 기술`}>
                  {project.featuredStack.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="project-links">
                  <a class="read-more" href={`/projects/${project.slug}/`}>상세 보기</a>
                  {project.github && <a href={project.github}>GitHub</a>}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" id="education" aria-labelledby="education-title">
        <div class="section-title">
          <p class="eyebrow">Education</p>
          <h2 id="education-title">Education</h2>
        </div>
        <article class="education-card">
          <span>{education.period}</span>
          <h3>{education.school}</h3>
          <p>{education.course}</p>
          <p>
            백엔드 개발 과정을 통해 Java/Spring 기반 서비스 개발, 팀 프로젝트 협업, 배포 자동화,
            모니터링, 동시성 제어와 같은 실무형 주제를 프로젝트로 학습했습니다.
          </p>
        </article>
      </section>

      <section class="section" id="certifications" aria-labelledby="certifications-title">
        <div class="section-title">
          <p class="eyebrow">Credentials</p>
          <h2 id="certifications-title">Certifications</h2>
        </div>
        <article class="record-card">
          <span>{certification.date}</span>
          <h3>{certification.name}</h3>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --ink: #17212b;
    --muted: #5f6f7c;
    --paper: #f5f7f4;
    --surface: #fffdfa;
    --line: #d8dfd9;
    --accent: #0f766e;
    --accent-dark: #155263;
    --accent-soft: #e2f2ee;
    --gold: #a16207;
    --shadow: 0 18px 44px rgba(23, 33, 43, 0.1);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      linear-gradient(120deg, rgba(15, 118, 110, 0.14), transparent 34rem),
      linear-gradient(230deg, rgba(161, 98, 7, 0.12), transparent 28rem),
      var(--paper);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 26px 0 72px;
  }

  .topbar {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    border-bottom: 1px solid var(--line);
  }

  .topbar div {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 800;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 32px;
    align-items: stretch;
    min-height: 66vh;
    padding: 50px 0 30px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p,
  dd {
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(4rem, 13vw, 8.2rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  h2 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.08;
    letter-spacing: 0;
  }

  h3 {
    margin: 0;
    font-size: 1.08rem;
    letter-spacing: 0;
  }

  .role {
    margin: 24px 0 0;
    color: var(--accent-dark);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .headline {
    max-width: 720px;
    margin: 18px 0 0;
    font-size: clamp(1.45rem, 3vw, 2.35rem);
    line-height: 1.22;
    font-weight: 850;
  }

  .summary,
  .section-title p,
  .project-card p,
  .education-card p,
  .record-card p {
    color: var(--muted);
    line-height: 1.72;
  }

  .summary {
    max-width: 700px;
    margin: 22px 0 0;
    font-size: 1.06rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 1px solid var(--ink);
    border-radius: 8px;
    color: var(--ink);
    font-weight: 800;
  }

  .actions .primary {
    background: var(--ink);
    color: #ffffff;
  }

  .profile-panel,
  .metric,
  .intro-card,
  .skill-card,
  .project-card,
  .education-card,
  .record-card {
    border: 1px solid rgba(216, 223, 217, 0.98);
    border-radius: 8px;
    background: rgba(255, 253, 250, 0.9);
    box-shadow: var(--shadow);
  }

  .profile-panel {
    align-self: center;
    padding: 28px;
  }

  .panel-heading {
    margin-bottom: 22px;
  }

  .panel-heading h2 {
    font-size: 1.45rem;
  }

  dl {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  dt {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  dd {
    margin: 6px 0 0;
    color: var(--ink);
    font-weight: 800;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding: 18px 0 42px;
  }

  .metric {
    padding: 18px;
  }

  .metric span,
  .project-top span,
  .education-card span,
  .record-card span {
    display: block;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .metric strong {
    display: block;
    margin-top: 8px;
    color: var(--accent-dark);
    font-size: 1.15rem;
  }

  .section {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 38px;
    padding: 52px 0;
    border-top: 1px solid var(--line);
  }

  .section-title {
    position: sticky;
    top: 24px;
    align-self: start;
  }

  .skill-grid,
  .intro-list,
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .intro-list {
    grid-template-columns: 1fr;
  }

  .intro-card,
  .skill-card,
  .project-card,
  .education-card,
  .record-card {
    padding: 22px;
  }

  .intro-card p {
    margin: 12px 0 0;
    color: var(--muted);
    line-height: 1.76;
  }

  .skill-card ul,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .skill-card li,
  .tags li {
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-dark);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .featured-tags li {
    background: rgba(226, 242, 238, 0.72);
    font-size: 0.84rem;
    line-height: 1.28;
  }

  .project-card {
    display: flex;
    min-height: 360px;
    flex-direction: column;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .project-card:hover {
    border-color: rgba(15, 118, 110, 0.42);
    box-shadow: 0 24px 54px rgba(23, 33, 43, 0.14);
    transform: translateY(-3px);
  }

  .project-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  .project-top strong {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .subtitle {
    margin: 8px 0 0;
    color: var(--accent-dark);
    font-weight: 800;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 24px;
  }

  .project-links a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 10px 13px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-weight: 900;
  }

  .project-links .read-more {
    border-color: rgba(15, 118, 110, 0.28);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .education-card h3 {
    margin-top: 12px;
  }

  .record-card h3 {
    margin-top: 12px;
  }

  .record-card .record-role {
    margin: 8px 0 0;
    color: var(--accent-dark);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .hero,
    .section,
    .intro-list,
    .skill-grid,
    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      position: static;
    }

    .project-card {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .shell {
      width: min(100% - 24px, 640px);
      padding: 18px 0 48px;
    }

    .topbar {
      justify-content: flex-start;
      padding-bottom: 14px;
    }

    .hero {
      min-height: auto;
      padding-top: 34px;
    }

    .metrics {
      grid-template-columns: 1fr;
      padding-bottom: 30px;
    }

    .section {
      gap: 22px;
      padding: 38px 0;
    }

    h1 {
      font-size: clamp(3.4rem, 22vw, 5.4rem);
    }
  }
</style>
